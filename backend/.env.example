# Copy to backend/.env  (never commit the real .env)
DATABASE_URL=sqlite:///./storage/agrimind.db
CORS_ORIGINS=http://localhost:5173
MODEL_FILE=mobilenetv2_final.keras
MAX_UPLOAD_MB=8
LOW_CONFIDENCE_THRESHOLD=0.60
# Optional absolute overrides (used by Docker/Render). Leave empty locally.
MODELS_DIR=
STORAGE_DIR=
# Satellite (optional, see docs/SATELLITE_SETUP.md)
EE_PROJECT=
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_FILE=
